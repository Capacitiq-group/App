# Laravel application configuration
APP_NAME='Snapi'
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:9696
FRONTEND_URL=http://localhost:9696
# Comma-separated list of allowed CORS origins (defaults to FRONTEND_URL if not set)
CORS_ALLOWED_ORIGINS=http://localhost:9696
AUTH_GUARD=api

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_SCHEDULE_TIMEZONE=Asia/Ho_Chi_Minh

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=snapi
DB_USERNAME=root
DB_PASSWORD=
DB_TIMEZONE=Asia/Ho_Chi_Minh

# Docker Compose override notes:
# - DB_HOST should resolve to service name: postgres
# - REDIS_HOST should resolve to service name: redis

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_HOST=mailcatcher
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-1
AWS_BUCKET="snapi"
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9000

VITE_APP_NAME="${APP_NAME}"

# JWT configuration — run: php artisan jwt:secret
JWT_SECRET=

# auth configuration
RESET_PASSWORD_EXPIRATION_MINUTES=60
RESET_PASSWORD_TOKEN_LENGTH=64

VERIFY_EMAIL_EXPIRATION_MINUTES=60
VERIFY_EMAIL_TOKEN_LENGTH=64


# ADMIN ACCOUNT CONFIGURATION — CHANGE BEFORE FIRST DEPLOY
SYSTEM_ADMIN_USER_NAME=admin
SYSTEM_ADMIN_PASSWORD=
SYSTEM_ADMIN_EMAIL=

# AI moderation integration
AI_MODERATION_ENABLED=false
AI_MODERATION_BASE_URL=http://ai-serve:8001
AI_MODERATION_TIMEOUT_SECONDS=3
AI_MODERATION_API_KEY=
AI_MODERATION_SYSTEM_ADMIN_ID=1
AI_MODERATION_APPEAL_WINDOW_DAYS=7
AI_MODERATION_KAFKA_BOOTSTRAP_SERVERS=kafka:29092
AI_MODERATION_KAFKA_REQUEST_TOPIC=moderation.request.v1
AI_MODERATION_KAFKA_RESULT_TOPIC=moderation.result.v1
AI_MODERATION_KAFKA_RESULT_GROUP_ID=snapi-ai-moderation-result-consumer
AI_MODERATION_KAFKA_BROKER_VERSION=3.6.0

# AI content generation integration
GEMINI_API_KEY=

# Agora (Spaces — real-time audio rooms)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_EXPIRY_SECONDS=3600

# Space V1 limits
SPACE_MIN_TO_START=5
SPACE_MIN_TO_CONTINUE=2
SPACE_MAX_PARTICIPANTS=50
SPACE_MAX_SPEAKERS=8
SPACE_DURATION_MINUTES=30
SPACE_HOST_MIN_ACCOUNT_AGE_DAYS=7
SPACE_HOST_MIN_PUBLIC_POSTS=3
SPACE_HOST_MIN_AGE_YEARS=18
# Space V1 limits
SPACE_MIN_TO_START=5
SPACE_MIN_TO_CONTINUE=2
SPACE_MAX_PARTICIPANTS=50
SPACE_MAX_SPEAKERS=8
SPACE_DURATION_MINUTES=30
SPACE_HOST_MIN_ACCOUNT_AGE_DAYS=7
SPACE_HOST_MIN_PUBLIC_POSTS=3
SPACE_HOST_MIN_AGE_YEARS=18
SPACE_HOST_MAX_PER_ROLLING_WEEK=3
SPACE_HOST_REQUIRES_VERIFICATION=false
SPACE_TICKET_PLATFORM_FEE_PERCENTAGE=10

# Broadcasting — Reverb (self-hosted WebSocket server, ships with Laravel)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=*

# Paystack (verification — recurring R99/month or R999/year subscription)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CURRENCY=ZAR
VERIFICATION_MONTHLY_FEE_CENTS=9900
VERIFICATION_ANNUAL_FEE_CENTS=99900
PAYSTACK_VERIFICATION_MONTHLY_PLAN_CODE=
PAYSTACK_VERIFICATION_ANNUAL_PLAN_CODE=
VERIFICATION_HOLD_EXPIRE_DAYS=5

# Tips
TIP_MIN_AMOUNT_CENTS=2000
TIP_PLATFORM_FEE_PERCENTAGE=10

# Didit (identity/KYB verification)
DIDIT_API_KEY=
DIDIT_API_BASE_URL=https://verification.didit.me/v3
DIDIT_WEBHOOK_SECRET=
DIDIT_WEBHOOK_MAX_AGE_SECONDS=300
DIDIT_WORKFLOW_URL_INDIVIDUAL=
DIDIT_WORKFLOW_URL_BUSINESS=
DIDIT_WORKFLOW_URL_POLITICAL=
